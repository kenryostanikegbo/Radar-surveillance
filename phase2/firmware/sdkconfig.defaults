# ESP-IDF sdkconfig defaults for the Radar Surveillance System.
# Apply with: idf.py set-target esp32-s3 && idf.py build

# ---- Target ----
CONFIG_IDF_TARGET="esp32s3"

# ---- PSRAM (N8R8 module) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_MEMBLOCK_SIZE=8192

# ---- Partition table (single 1.5 MB app) ----
CONFIG_PARTITION_TABLE_SINGLE_APP=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Wi-Fi softAP ----
CONFIG_ESP_WIFI_AP_ENABLE=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# ---- HTTP server ----
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=128

# ---- TFLite Micro ----
# Component brought in via idf_component_manager.yml:
#   espressif/esp-tflite-micro

# ---- Logging ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_TAG_LEVEL_IMPL="*:W"
